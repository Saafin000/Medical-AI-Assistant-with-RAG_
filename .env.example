# LLM Provider Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_if_needed

# HuggingFace Configuration
HUGGINGFACE_TOKEN=your_huggingface_token_if_needed

# ElevenLabs TTS Configuration (Optional)
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key

# Azure Configuration (Optional - only if using Azure LLMs for image analysis)
deployment_name=your_deployment_name
model_name=your_model_name
azure_endpoint=your_azure_endpoint
openai_api_key=your_openai_api_key
openai_api_version=your_openai_api_version

# Application Configuration
DEBUG=true
LOG_LEVEL=INFO

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_groq_model_here

# Google Gemini Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Embedding Configuration
EMBEDDING_MODE=your_embedding_mode_here

# Qdrant Cluster Configuration
Cluster_Endpoint=your_cluster_endpoint_here
